{
  "name": "pmanager-cmms",
  "version": "0.1.0",
  "private": true,
  "description": "Factory Preventive Maintenance System (CMMS) - Persian RTL & Intranet-Ready",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cmms/db db:generate",
    "db:migrate": "pnpm --filter @cmms/db db:migrate",
    "db:studio": "pnpm --filter @cmms/db db:studio"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  }
}
