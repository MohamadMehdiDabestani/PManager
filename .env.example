# Environment Configuration (CMMS)
NODE_ENV=development
TZ=Asia/Tehran

# PostgreSQL (Local or Remote)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pmanager_cmms

# Redis (Remote Docker or Local - Dedicated for BullMQ)
REDIS_URL=redis://:changeme_redis_pass@localhost:6379/0
QUEUE_PREFIX=cmms_dev

# Auth.js (NextAuth)
AUTH_SECRET=replace_with_32_byte_random_hex_secret_for_intranet
AUTH_URL=http://localhost:3000

# Notification Channels (Priority: 1. SMS (SMS.ir) -> 2. Bale -> 3. Eitaa -> 4. Email)
SMS_PROVIDER=smsir
SMS_API_KEY=
SMS_LINE_NUMBER=300000000000
SMS_SENDER=300000000000
SMS_API_BASE_URL=https://api.sms.ir
SMS_SEND_METHOD=POST
SMS_USERNAME=

BALE_BOT_TOKEN=
BALE_API_BASE_URL=https://tapi.bale.ai

EITAA_BOT_TOKEN=
EITAA_API_BASE_URL=https://eitaayar.ir/api

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cmms@factory.local
